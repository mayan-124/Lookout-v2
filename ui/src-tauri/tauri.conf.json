{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lookout",
  "version": "0.0.1",
  "identifier": "dev.lookout.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "bar",
        "title": "Lookout",
        "width": 940,
        "height": 640,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Lookout",
    "shortDescription": "Local-first command bar for Windows",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCRkRCMEZDMTVCRTE5MjAKUldRZ0diNFYvTEQ5Nnd5bzZ2Tlk0NDl4Vk9FQktWWnZBcWdoamp5OEFXSGNuUW9FM3FNSVc0VWUK",
      "endpoints": [
        "https://github.com/mayan-124/Lookout-v2/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
